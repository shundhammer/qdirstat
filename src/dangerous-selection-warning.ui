     <property name="text">
      <string>## Dangerous Selection!</string>
     </property>
     <property name="textFormat">
      <enum>Qt::TextFormat::MarkdownText</enum>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="whatHappenedLabel">
     <property name="text">
      <string>You selected an item whose tree parent (or grandparent etc.) was already selected.

This is **dangerous**: Any action like deleting or moving to trash will affect not only the item that you just selected, but the complete subtree from that ancestor on downwards.

**You are about to shoot yourself in the foot.**

**Do not** start a selection with `[Shift]`-click or `[Ctrl]`-click!

Use a **simple click** without `[Shift]` or [`Ctrl`] to start a selection!</string>
     </property>
     <property name="textFormat">
      <enum>Qt::TextFormat::MarkdownText</enum>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
